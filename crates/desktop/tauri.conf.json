{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyWork",
  "version": "0.1.31",
  "identifier": "dev.anywork.desktop",
  "build": {
    "frontendDist": "../../desktop/ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AnyWork",
        "theme": "Light",
        "backgroundColor": "#FFFFFF",
        "width": 960,
        "height": 720,
        "minWidth": 800,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../desktop/icon.icns",
      "../../desktop/icon.png",
      "../../desktop/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "infoPlist": "../../desktop/Bundle.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0MjA5QkYzMkJDNUUwQjQKUldTMDRNVXI4NXNnaEQzQ2g3NTdsNk9TZFlxdUJselRFbmpHS3JaK2ZsMU85V1IyN1NzMVR5ZTAK",
      "endpoints": [
        "https://github.com/ywateru/AnyWork/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "mainBinaryName": "anywork-desktop"
}
