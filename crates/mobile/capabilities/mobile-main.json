{
  "identifier": "mobile-main",
  "description": "Only the bundled business window; no remote URL grants.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "mobile-system:allow-export-begin",
    "mobile-system:allow-export-write",
    "mobile-system:allow-export-finish",
    "mobile-system:allow-export-abort",
    "mobile-system:allow-open-external",
    "mobile-system:allow-back-set-state",
    "mobile-system:allow-appearance-set",
    "mobile-system:allow-insets-get",
    "allow-mobile-transport-http-begin",
    "allow-mobile-transport-http-write",
    "allow-mobile-transport-http-finish",
    "allow-mobile-transport-http-read",
    "allow-mobile-transport-cancel",
    "allow-mobile-transport-close",
    "allow-mobile-transport-pty",
    "allow-mobile-account-snapshot",
    "allow-mobile-account-login",
    "allow-mobile-account-cancel",
    "allow-mobile-account-logout",
    "allow-mobile-account-refresh",
    "allow-mobile-account-device-update",
    "allow-mobile-transport-connect"
  ]
}
