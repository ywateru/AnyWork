diff --git a/server/src/application-directory-config.ts b/server/src/application-directory-config.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9deaf75cecbbdab5cce5f72bd6d930037533fc2f
--- /dev/null
+++ b/server/src/application-directory-config.ts
@@ -0,0 +1,48 @@
+import {LogtoDirectory} from './directory.js';
+import type {Application,ApplicationDirectory} from './types.js';
+
+export class DirectoryConfigurationError extends Error {
+ readonly code='INVALID_APPLICATION_DIRECTORY';
+ constructor(){super('Invalid pinned Logto application directory configuration');this.name='DirectoryConfigurationError';}
+}
+function invalid():never {throw new DirectoryConfigurationError();}
+
+/** Immutable deployment declarations, never selected or changed by a request. */
+export class PinnedApplicationDirectory implements ApplicationDirectory {
+ private readonly apps:Application[];
+ constructor(raw:unknown,browserClientId:string){
+  if(!Array.isArray(raw)||raw.length<2||raw.length>32)invalid();
+  const ids=new Set<string>();let spas=0,natives=0;
+  this.apps=raw.map((value:unknown)=>{
+   if(!value||typeof value!=='object'||Array.isArray(value))return invalid();
+   const app=value as Record<string,unknown>;
+   if(Object.keys(app).sort().join(',')!=='id,isDeviceFlow,name,type')return invalid();
+   const {id,name,type,isDeviceFlow}=app;
+   if(typeof id!=='string'||id.length<1||id.length>21||/[\s\u0000-\u001f\u007f]/u.test(id)||ids.has(id)||typeof name!=='string'||!name.trim()||name.length>256||/[\u0000-\u001f\u007f]/u.test(name)||isDeviceFlow!==false)return invalid();
+   if(type==='SPA'){spas++;if(id!==browserClientId)return invalid();}
+   else if(type==='Native')natives++;
+   else return invalid();
+   ids.add(id);return {id,name,type,isDeviceFlow};
+  });
+  if(spas!==1||natives<1)invalid();
+ }
+ async list():Promise<Application[]>{return this.apps.map(app=>({...app}));}
+}
+
+/** Explicit pinned mode cannot adopt management credentials or fall back. */
+export function configuredApplicationDirectory(env:NodeJS.ProcessEnv):ApplicationDirectory {
+ try{
+  const mode=env.LOGTO_APPLICATION_DIRECTORY_MODE;
+  if(mode==='pinned'){
+   if(env.LOGTO_MANAGEMENT_CLIENT_ID!==undefined||env.LOGTO_MANAGEMENT_CLIENT_SECRET!==undefined)invalid();
+   const raw=env.LOGTO_APPLICATIONS_JSON,browser=env.LOGTO_BROWSER_CLIENT_ID;
+   if(raw===undefined||Buffer.byteLength(raw)>32_768||!browser)invalid();
+   return new PinnedApplicationDirectory(JSON.parse(raw),browser);
+  }
+  if(mode!==undefined&&mode!=='management')invalid();
+  if(env.LOGTO_APPLICATIONS_JSON!==undefined)invalid();
+  const issuer=env.LOGTO_ISSUER,id=env.LOGTO_MANAGEMENT_CLIENT_ID,secret=env.LOGTO_MANAGEMENT_CLIENT_SECRET;
+  if(!issuer||!id||!secret)invalid();
+  return new LogtoDirectory({issuer,clientId:id,clientSecret:secret});
+ }catch{throw new DirectoryConfigurationError();}
+}
