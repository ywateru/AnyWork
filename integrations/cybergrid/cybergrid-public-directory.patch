@@ -0,0 +1,111 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {inspect} from 'node:util';
+import {createLocalJWKSet,exportJWK,generateKeyPair,SignJWT} from 'jose';
+import {configuredApplicationDirectory,DirectoryConfigurationError,PinnedApplicationDirectory} from '../src/application-directory-config.js';
+import {createConfiguredCoordinator} from '../src/config.js';
+import {coordinatorAuthConfiguration} from '../src/deployment-config.js';
+import {LogtoDirectory} from '../src/directory.js';
+import {LogtoIdentity} from '../src/identity.js';
+import {MemoryStore} from '../src/memory.js';
+import {createService} from '../src/service.js';
+
+const SPA='PinnedSPA',NATIVE='PinnedNative',OTHER='OtherNative';
+const declarations=()=>[
+ {id:SPA,name:'Web console',type:'SPA',isDeviceFlow:false},
+ {id:NATIVE,name:'Desktop',type:'Native',isDeviceFlow:false},
+];
+const environment=():NodeJS.ProcessEnv=>({
+ LOGTO_ISSUER:'https://identity.example/oidc',LOGTO_BROWSER_CLIENT_ID:SPA,
+ LOGTO_RESOURCE:'https://grid.example/api',CYBERGRID_PUBLIC_ORIGIN:'https://grid.example',
+ LOGTO_APPLICATION_DIRECTORY_MODE:'pinned',LOGTO_APPLICATIONS_JSON:JSON.stringify(declarations()),
+});
+const rejects=(fn:()=>unknown)=>assert.throws(fn,(error:unknown)=>error instanceof DirectoryConfigurationError&&error.code==='INVALID_APPLICATION_DIRECTORY');
+
+test('pinned declarations return defensive copies without any management request or secret',async t=>{
+ let requests=0;t.mock.method(globalThis,'fetch',async()=>{requests++;throw Error('Network must not be used for pinned applications');});
+ const input=declarations(),directory=new PinnedApplicationDirectory(input,SPA);
+ input[1]!.id='changed';const first=await directory.list();assert.equal(first[1]!.id,NATIVE);
+ first[1]!.type='MachineToMachine';first.splice(0);assert.deepEqual(await directory.list(),declarations());
+ const configured=configuredApplicationDirectory(environment());assert.deepEqual(await configured.list(),declarations());
+ const coordinator=createConfiguredCoordinator({...environment(),CYBERGRID_REDIS_TRANSPORT:'upstash-rest',UPSTASH_REDIS_REST_URL:'https://redis.example',UPSTASH_REDIS_REST_TOKEN:'fixture-write-token'});
+ coordinator.close();assert.equal(requests,0);
+});
+
+test('pinned startup rejects missing, mixed or unknown mode configuration without adopting legacy credentials',()=>{
+ const good=environment();
+ for(const env of [
+  {...good,LOGTO_APPLICATIONS_JSON:undefined},{...good,LOGTO_APPLICATIONS_JSON:''},
+  {...good,LOGTO_APPLICATIONS_JSON:'[]'},{...good,LOGTO_APPLICATIONS_JSON:' '.repeat(32_769)},
+  {...good,LOGTO_BROWSER_CLIENT_ID:undefined},{...good,LOGTO_BROWSER_CLIENT_ID:'DifferentSPA'},
+  {...good,LOGTO_MANAGEMENT_CLIENT_ID:''},{...good,LOGTO_MANAGEMENT_CLIENT_SECRET:''},
+  {...good,LOGTO_MANAGEMENT_CLIENT_ID:'machine',LOGTO_MANAGEMENT_CLIENT_SECRET:'fixture-secret'},
+  ...['','Pinned','pinned ','__proto__','unknown'].map(mode=>({...good,LOGTO_APPLICATION_DIRECTORY_MODE:mode})),
+  {...good,LOGTO_APPLICATION_DIRECTORY_MODE:undefined},
+  {...good,LOGTO_APPLICATION_DIRECTORY_MODE:'management',LOGTO_MANAGEMENT_CLIENT_ID:'machine',LOGTO_MANAGEMENT_CLIENT_SECRET:'fixture-secret'},
+ ]){rejects(()=>configuredApplicationDirectory(env));rejects(()=>createConfiguredCoordinator(env));}
+ const marker='do-not-echo-private-marker';
+ for(const raw of ['{"'+marker+'"',JSON.stringify([{...declarations()[0],secret:marker},declarations()[1]])]){
+  assert.throws(()=>configuredApplicationDirectory({...good,LOGTO_APPLICATIONS_JSON:raw}),(error:unknown)=>error instanceof DirectoryConfigurationError&&!inspect(error).includes(marker)&&!JSON.stringify(error).includes(marker));
+ }
+});
+
+test('pinned schema rejects incomplete, duplicate, excessive, flow-enabled and unsupported application declarations',()=>{
+ const [spa,native]=declarations();
+ for(const raw of [
+  null,{},'apps',[],[spa],[native],
+  [spa,spa,native],[spa,native,{...native}],[spa,{...native,id:SPA}],
+  [spa,{...native,type:'MachineToMachine'}],[{...spa,type:'Traditional'},native],
+  [spa,{...native,isDeviceFlow:true}],[spa,{...native,isDeviceFlow:'false'}],
+  [spa,{id:NATIVE,name:'Desktop',type:'Native'}],[spa,{...native,secret:'private'}],
+  [spa,{...native,id:''}],[spa,{...native,id:'with space'}],[spa,{...native,id:'x'.repeat(22)}],
+  [spa,{...native,id:'\0bad'}],[spa,{...native,name:''}],[spa,{...native,name:'  '}],
+  [spa,{...native,name:'x'.repeat(257)}],[spa,{...native,name:'line\nbreak'}],
+  [spa,...Array.from({length:32},(_,i)=>({...native,id:'native'+i}))],
+ ])rejects(()=>new PinnedApplicationDirectory(raw,SPA));
+});
+
+test('legacy management selection remains explicit and compatible but never accepts pinned JSON',()=>{
+ const env={LOGTO_ISSUER:'https://identity.example/oidc',LOGTO_MANAGEMENT_CLIENT_ID:'machine',LOGTO_MANAGEMENT_CLIENT_SECRET:'fixture-secret'};
+ assert(configuredApplicationDirectory(env) instanceof LogtoDirectory);
+ assert(configuredApplicationDirectory({...env,LOGTO_APPLICATION_DIRECTORY_MODE:'management'}) instanceof LogtoDirectory);
+ rejects(()=>configuredApplicationDirectory({...env,LOGTO_APPLICATIONS_JSON:''}));
+ rejects(()=>configuredApplicationDirectory({...env,LOGTO_MANAGEMENT_CLIENT_SECRET:undefined}));
+});
+
+test('signed user exchanges keep fixed identity, Native/SPA purpose, CORS and application-removal checks',async t=>{
+ const env=environment(),config=coordinatorAuthConfiguration(env),keys=await generateKeyPair('ES384');
+ const publicKey={...await exportJWK(keys.publicKey),kid:'pinned-test',alg:'ES384'};
+ const identity=new LogtoIdentity(config,['ES384'],createLocalJWKSet({keys:[publicKey]}));
+ const store=new MemoryStore();t.after(()=>store.close());
+ const service=(directory=configuredApplicationDirectory(env))=>createService({store,identity,directory,browserClientId:SPA,browserOrigins:new Set(['https://web.example']),authRateLimit:100});
+ const handle=service();const now=Math.floor(Date.now()/1000);
+ const token=(changes:Record<string,unknown>={})=>new SignJWT({sub:'fixture-user',iss:config.issuer,aud:config.resource,client_id:NATIVE,scope:'openid connect',iat:now,exp:now+60,...changes}).setProtectedHeader({alg:'ES384',kid:'pinned-test',typ:'JWT'}).sign(keys.privateKey);
+ const request=async(path:string,body?:unknown,key?:string,origin?:string,handler=handle,method=body===undefined?'GET':'POST')=>{
+  const response=await handler(new Request('https://grid.example/api/v1'+path,{method,headers:{...(body!==undefined?{'content-type':'application/json'}:{}),...(key?{authorization:'Bearer '+key}:{}),...(origin?{origin}:{})},...(body!==undefined?{body:JSON.stringify(body)}:{})}),'pinned-fixture');
+  return {status:response.status,headers:response.headers,data:await response.json() as any};
+ };
+ const nativeConfig=await request('/auth/config?appId='+NATIVE);
+ assert.equal(nativeConfig.status,200);assert.equal(nativeConfig.data.clientId,NATIVE);assert.equal(nativeConfig.data.issuer,config.issuer);assert.equal(nativeConfig.data.resource,config.resource);
