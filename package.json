{
  "name": "anywork-workspace",
  "private": true,
  "version": "0.1.30",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "web",
    "desktop/ui"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "npm run test -w web",
    "test:e2e": "playwright test",
    "format": "prettier --write web/src web/scripts web/vite.config.ts e2e playwright.config.ts",
    "format:check": "prettier --check web/src web/scripts web/vite.config.ts e2e playwright.config.ts",
    "build:desktop-ui": "npm run build -w anywork-desktop-ui",
    "version:patch": "python3 scripts/bump-version.py patch",
    "test:desktop-updater": "npm run build:desktop-ui && node scripts/desktop-updater-test.mjs",
    "release": "python3 scripts/publish.py",
    "build:mobile-ui": "npm exec -w web -- vite build --config vite.mobile.config.ts",
    "build:android": "bash scripts/build-android.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "2.12.4",
    "prettier": "^3.9.10"
  }
}
